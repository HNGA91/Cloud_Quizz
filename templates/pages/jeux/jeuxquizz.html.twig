{% extends "base.html.twig" %}

{% block title %}Quizz : {{ themeQuizz.titre }} {{ jeuxQuizz.jeux }}{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div id="quiz" data-quizz-id="{{ jeuxQuizz.id }}">
			<h1 class="h1-jeux text-center">
				Quizz : {{ themeQuizz.titre }} {{ jeuxQuizz.jeux }}
			</h1>

			{% if jouable %}
				<div class="row mt-5">
					<div class="col-12">
						<h2 id="question" class="fw-bold text-center"></h2>

						<img id="question-image" class="question-image-jeux d-block mx-auto" alt="" hidden>

						{# Boutons de réponse créés par quizz.js (2, 3 ou 4 selon la question) #}
						<div id="choices" class="choices-jeux"></div>

						<p id="feedback" class="feedback-jeux text-center fw-bold" aria-live="polite"></p>

						<div class="text-center">
							<button id="suivant" type="button" class="btn btn-primary btn-lg" hidden>Question suivante</button>
						</div>

						<p id="progress" class="fw-bold text-center mt-3"></p>
						<h3 id="score" class="h3-jeux text-center"></h3>
					</div>
				</div>

				<div id="fin" class="text-center mt-5" hidden>
					<h2 class="h3-jeux">Quizz terminé !</h2>
					<p class="fs-3 fw-bold">Votre score : <span id="score-final"></span></p>
				</div>
			{% else %}
				<p class="alert alert-warning text-center mt-5">Ce quizz n'est pas encore disponible.</p>
			{% endif %}

			<div class="row-jeuxquizz">
				<a href="{{ path('jeux_quizz_page', {id: jeuxQuizz.id}) }}" class="btn btn-jeuxquizz btn-warning">Recommencer</a>
				<a href="{{ path('theme_quizz_page', {id: themeQuizz.id}) }}" class="btn btn-jeuxquizz btn-danger">Retour aux quizz</a>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{% if jouable %}
		<script src="{{ asset('javascript/quizz.js') }}"></script>
	{% endif %}
{% endblock %}
