{% extends 'base.html.twig' %}

{% block title %}QuestionQuizz{% endblock %}

{% block stylesheets %}
            {#{{ encore_entry_link_tags('app') }}#}
            <link rel="stylesheet" href="{{ asset("css/nuage.css") }}">
{% endblock %}

{% block body %}
    <h1>QuestionQuizz</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ question_quizz.id }}</td>
            </tr>
            <tr>
                <th>Jeux</th>
                <td>{{ question_quizz.jeuxQuizz.Jeux }}</td>
            </tr>
            <tr>
                <th>Question</th>
                <td>{{ question_quizz.question }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    {% if question_quizz.image %}
                        <img src="{{ asset(question_quizz.image) }}" alt="" style="max-height: 80px;">
                    {% else %}—{% endif %}
                </td>
            </tr>
            {% for choix in question_quizz.choix %}
                <tr>
                    <th>Choix {{ loop.index }}</th>
                    <td>
                        {% if choix.image %}
                            <img src="{{ asset(choix.image) }}" alt="{{ choix.libelle }}" style="max-height: 40px;" class="me-2">
                        {% endif %}
                        {{ choix.libelle }}
                        {% if choix.estCorrect %}<span class="badge bg-success ms-2">Bonne réponse</span>{% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('question_quizz_index') }}" class="btn btn-primary">Retour à la liste</a>

    <a href="{{ path('question_quizz_edit', {'id': question_quizz.id}) }}" class="btn btn-warning">Modifier</a>

    {{ include('question_quizz/_delete_form.html.twig') }}
{% endblock %}
