{% extends 'base.html.twig' %}

{% block title %}Commande{% endblock %}

{% block stylesheets %}
            {#{{ encore_entry_link_tags('app') }}#}
            <link rel="stylesheet" href="{{ asset("css/nuage.css") }}">
{% endblock %}

{% block body %}
    <h1 class="my-5 text-center">Commande</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ commande.id }}</td>
            </tr>
            <tr>
                <th>Reference</th>
                <td>{{ commande.reference }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ commande.createdAt ? commande.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ commande.prix|number_format(2, ',', ' ') }} €</td>
            </tr>
            <tr>
                <th>Client</th>
                <td>{{ commande.user ? commande.user.email : '—' }}</td>
            </tr>
            <tr>
                <th>Paiement Stripe</th>
                <td>{{ commande.stripeSessionId ?? '—' }}</td>
            </tr>
            <tr>
                <th>Articles</th>
                <td>
                    {% for ligne in commande.lignes %}
                        <div>{{ ligne.quantite }} × {{ ligne.titre }} — {{ ligne.prixUnitaire|number_format(2, ',', ' ') }} € l'unité</div>
                    {% else %}
                        —
                    {% endfor %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('commande_index') }}" class="btn btn-primary">Retour à la liste</a>

    <a href="{{ path('commande_edit', {'id': commande.id}) }}" class="btn btn-warning">Modifier</a>

    {{ include('commande/_delete_form.html.twig') }}
{% endblock %}
